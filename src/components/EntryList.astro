---
import { formatDate, type Entry } from "../lib/entries";

interface Props {
    entries: Entry[];
}

const { entries } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

{entries.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
) : (
    <ul class="entries">
        {entries.map((e) => (
            <li>
                <a href={`${base}/${e.collection}/${e.id}/`}>{e.data.title}</a>
                {e.data.date && (
                    <time datetime={e.data.date.toISOString()}>
                        {formatDate(e.data.date)}
                    </time>
                )}
                {e.data.description && <p>{e.data.description}</p>}
            </li>
        ))}
    </ul>
)}

<style>
    .entries {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    li {
        padding: 1rem 0;
        border-bottom: 1px solid var(--border);
    }
    a {
        font-size: 1.1rem;
        font-weight: 600;
    }
    time {
        display: block;
        color: var(--muted);
        font-size: 0.9rem;
        margin-top: 0.15rem;
    }
    p {
        margin: 0.35rem 0 0;
        color: var(--muted);
    }
    .empty {
        color: var(--muted);
        font-style: italic;
    }
</style>
