---
import { CATEGORIES, DEFAULT_CATEGORY, SITE } from "../config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
const isActive = (id: string) =>
    path === `/${id}` ||
    path.startsWith(`/${id}/`) ||
    (path === "/" && id === DEFAULT_CATEGORY);
---

<header class="site-header">
    <div class="inner">
        <a class="site-title" href={`${base}/`}>
            {SITE.title}
        </a>
        <p class="description">{SITE.description}</p>
        <p class="team">{SITE.team.join(" · ")}</p>
        <nav aria-label="Sections">
            <ul>
                {CATEGORIES.map((c) => (
                    <li>
                        <a
                            href={`${base}/${c.id}/`}
                            aria-current={isActive(c.id) ? "page" : undefined}
                        >
                            {c.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<style>
    .site-header {
        border-bottom: 1px solid var(--border);
        background: var(--surface);
    }
    .inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 1rem var(--gutter) 0;
    }
    .site-title {
        display: inline-block;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text);
        text-decoration: none;
    }
    .description {
        margin: 0.25rem 0 0;
        color: var(--muted);
    }
    .team {
        margin: 0.25rem 0 0.75rem;
        color: var(--muted);
        font-size: 0.875rem;
    }
    ul {
        display: flex;
        gap: 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
        overflow-x: auto;
    }
    nav a {
        display: block;
        padding: 0.5rem 0.9rem;
        border-bottom: 2px solid transparent;
        color: var(--muted);
        text-decoration: none;
        white-space: nowrap;
    }
    nav a:hover {
        color: var(--text);
    }
    nav a[aria-current="page"] {
        color: var(--accent);
        border-bottom-color: var(--accent);
        font-weight: 600;
    }
</style>
